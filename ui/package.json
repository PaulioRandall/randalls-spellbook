{
	"name": "randalls-spellbook",
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PaulioRandall/randalls-spellbook.git"
	},
	"scripts": {
		"update": "npx npm-check-updates -u && npm i",
		"clean": "rm -rf .svelte-kit",
		"fmt": "prettier --log-level warn --write .",
		"build": "npm run fmt && vite build",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --testPathPatterns ./src/",
		"dev": "npm run fmt && vite dev --port 3000",
		"preview": "npm run build && vite preview --port 4000",
		"audit": "npm run build && cat ./ready-to-integrate.txt",
		"buildlessaudit": "cat ./ready-to-integrate.txt"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"jest": "30.5.2",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"vite": "8.3.4"
	}
}
